{
  "name": "pdf-slideshow",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "convert": "npm run build:scripts && node dist/scripts/convert-pdfs.js",
    "lint": "eslint . --ext .js,.ts,.astro",
    "lint:fix": "eslint . --ext .js,.ts,.astro --fix",
    "format": "prettier --write \"**/*.{js,ts,astro,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,astro,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "astro": "^7.3.4",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.35.4",
    "xmlbuilder2": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/ui": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "happy-dom": "^20.14.5",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^1.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "astro-eslint-parser": "^3.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
